// 32 bit full subtractor
module sub32(a, b, bin, diff, bout);
	input logic [31:0] a, b;
	input logic bin;
	
	output logic [31:0] diff;
	logic [32:0] carrywire;
	output logic bout;
	
	genvar i;
	
	assign carrywire[0] = bin;
	
	generate
		for (i = 0; i < 32; i++) begin : subtractors
			sub1 subtractor (.a(a[i]), .b(b[i]), .bin(carrywire[i]), .diff(diff[i]), .bout(carrywire[i+1]));
		end
	endgenerate
	
	assign bout = carrywire[32];
	
endmodule

module sub32_testbench();
	logic [31:0] a, b, diff;
	logic bin, bout;
	
	sub32 dut (.a, .b, .bin, .diff, .bout);
	
	initial begin
		a = 32'hFFFFFFFF; b = 32'h00000001; bin = 0; #10;
		a = 32'hAAAAAAAA; b = 32'h55555555; bin = 0; #10;
	end
endmodule