module register_file(clk, reset, read_register_A, read_register_B, read_data_A, read_data_B, write_addr, write_data, write_en);
	input logic clk, reset;
	input logic [3:0] read_register_A, read_register_B; 
	input logic write_addr;
	input logic [31:0] write_data;
	input logic write_en;
	
	output logic [31:0] read_data_A, read_data_B;
	
	logic [31:0] my_register [15:0];
	
	
	
endmodule